# A&J Field App — Server Environment Variables
# Copy this to .env and fill in your values

# Resend API Key (get from resend.com)
RESEND_API_KEY=re_your_key_here

# Office email to receive all submissions
OFFICE_EMAIL=kathie@ajcaliforniabuilders.com

# Admin panel password
ADMIN_PASSWORD=ajbuilders2025

# Frontend URL (your Netlify URL once deployed)
FRONTEND_URL=https://aj-field-app.netlify.app

# Port (Render sets this automatically)
PORT=3001

# Database path (Render persistent disk path)
DB_PATH=/data/ajfield.db
